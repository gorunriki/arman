<% content_for :title, "Statistik Arsip Magang" %>
<% chart_base_options = {
     responsive: true,
     maintainAspectRatio: false,
     plugins: { legend: { labels: { color: "#475569", font: { size: 12 } } } }
   } %>
<% chart_axis_options = chart_base_options.deep_merge(
     scales: {
       x: { ticks: { color: "#475569", font: { size: 12 } }, grid: { color: "rgba(100, 116, 139, 0.12)" }, border: { display: false } },
       y: { ticks: { color: "#475569", font: { size: 12 } }, grid: { color: "rgba(100, 116, 139, 0.12)" }, border: { display: false } }
     }
   ) %>

<div class="mx-auto min-w-0 w-full max-w-6xl pb-12" data-dashboard-charts>
  <header class="overflow-hidden rounded-3xl bg-neutral text-neutral-content shadow-sm">
    <div class="relative px-6 py-9 sm:px-10 sm:py-12">
      <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div class="max-w-3xl">
          <div class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-neutral-content/65">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V9M10 19V5M16 19v-7M22 19H2" />
            </svg>
            Ringkasan Data
          </div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Statistik Arsip Magang</h1>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-neutral-content/70 sm:text-base">
            Gambaran umum penyelenggara, lowongan, kuota, dan pelamar berdasarkan data yang tersimpan dalam arsip.
          </p>
          <% if @last_updated_at %>
            <p class="mt-3 flex items-center gap-2 text-xs text-neutral-content/55">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" d="M12 7v5l3 2" />
              </svg>
              Terakhir diperbarui <time datetime="<%= @last_updated_at.iso8601 %>"><%= @last_updated_at.strftime("%d/%m/%Y") %></time>
            </p>
          <% end %>
        </div>

        <div class="flex flex-wrap gap-3">
          <%= link_to "Lihat penyelenggara", organizers_path, class: "btn btn-ghost btn-sm border-neutral-content/30 text-neutral-content hover:bg-neutral-content/10 sm:btn-md" %>
        </div>
      </div>
    </div>
  </header>

  <section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Statistik utama">
    <% [
      [ "Total penyelenggara", @stats[:organizers], "Instansi dan perusahaan yang tercatat", :organizers ],
      [ "Total lowongan", @stats[:vacancies], "Seluruh rekaman lowongan magang", :vacancies ],
      [ "Kuota diajukan", @stats[:requested_quota], "Akumulasi kebutuhan penyelenggara", :requested_quota ],
      [ "Kuota diberikan", @stats[:approved_quota], "#{number_with_precision(@stats[:approval_rate], precision: 1, separator: ",", delimiter: ".")}% dari #{number_with_delimiter(@stats[:requested_quota], delimiter: ".")} kuota diajukan", :approved_quota ],
      [ "Pelamar tercatat", @stats[:applications], "Akumulasi pelamar pada data arsip", :applications ],
      [ "Kota tercakup", @stats[:covered_cities], "Kota yang memiliki arsip lowongan", :cities ]
    ].each do |label, value, description, icon| %>
      <article class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-[0_1px_2px_rgba(23,32,51,0.06)]" data-stat-card>
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-sm font-medium text-base-content/70"><%= label %></p>
            <p class="mt-2 text-3xl font-bold tracking-tight text-base-content"><%= number_with_delimiter(value) %></p>
          </div>
          <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary">
            <%= render "dashboard/stat_icon", icon: icon %>
          </div>
        </div>
        <p class="mt-3 text-xs leading-5 text-base-content/60"><%= description %></p>
        <% if icon == :approved_quota %>
          <progress class="progress progress-primary mt-3 h-1.5 w-full" value="<%= @stats[:approval_rate] %>" max="100" aria-label="<%= number_with_precision(@stats[:approval_rate], precision: 1, separator: ",", delimiter: ".") %> persen kuota diberikan"></progress>
        <% end %>
      </article>
    <% end %>
  </section>

  <section class="mt-8 grid min-w-0 gap-6 lg:grid-cols-2" aria-label="Visualisasi statistik">
    <article class="min-w-0 overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-4 shadow-[0_1px_2px_rgba(23,32,51,0.06)] sm:p-5" data-chart-card>
      <div class="mb-5">
        <h2 class="text-lg font-bold text-base-content">Jenis penyelenggara</h2>
        <p class="mt-1 text-sm text-base-content/65">Komposisi seluruh penyelenggara</p>
      </div>
      <div class="relative h-64 min-w-0 sm:h-72">
        <%= pie_chart @organizers_by_type,
                      donut: true,
                      height: "100%",
                      colors: [ "#28756f", "#64748b", "#a8b4c2" ],
                      legend: "bottom",
                      thousands: ".",
                      library: chart_base_options,
                      empty: "Belum ada data penyelenggara" %>
        <% if @organizers_by_type.present? %>
          <div class="pointer-events-none absolute inset-x-0 top-[42%] -translate-y-1/2 text-center" aria-hidden="true">
            <p class="text-2xl font-bold text-base-content"><%= number_with_delimiter(@stats[:organizers]) %></p>
            <p class="mt-0.5 text-xs text-base-content/60">Penyelenggara</p>
          </div>
        <% end %>
      </div>
    </article>

    <article class="min-w-0 overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-4 shadow-[0_1px_2px_rgba(23,32,51,0.06)] sm:p-5" data-chart-card>
      <div class="mb-5">
        <h2 class="text-lg font-bold text-base-content">Kuota menurut jenis penyelenggara</h2>
        <p class="mt-1 text-sm text-base-content/65">Perbandingan kuota yang diajukan dan diberikan</p>
      </div>
      <div class="h-72 min-w-0 sm:h-80">
        <%= column_chart @quota_by_type,
                         height: "100%",
                         colors: [ "#718096", "#28756f" ],
                         legend: "bottom",
                         thousands: ".",
                         suffix: " kuota",
                         library: chart_axis_options,
                         empty: "Belum ada data kuota" %>
      </div>
    </article>

    <article class="min-w-0 overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-4 shadow-[0_1px_2px_rgba(23,32,51,0.06)] sm:p-5" data-chart-card>
      <div class="mb-5">
        <h2 class="text-lg font-bold text-base-content">Kota dengan arsip terbanyak</h2>
        <p class="mt-1 text-sm text-base-content/65">Sepuluh kota berdasarkan jumlah lowongan</p>
      </div>
      <div class="h-80 min-w-0 sm:h-96">
        <%= bar_chart @top_cities,
                      height: "100%",
                      colors: [ "#436f7a" ],
                      legend: false,
                      thousands: ".",
                      suffix: " lowongan",
                      library: chart_axis_options,
                      empty: "Belum ada data kota" %>
      </div>
    </article>

    <article class="min-w-0 overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-4 shadow-[0_1px_2px_rgba(23,32,51,0.06)] sm:p-5" data-chart-card>
      <div class="mb-5">
        <h2 class="text-lg font-bold text-base-content">Program studi teratas</h2>
        <p class="mt-1 text-sm text-base-content/65">Program yang paling sering diterima</p>
      </div>
      <div class="h-80 min-w-0 sm:h-96">
        <%= bar_chart @top_study_programs,
                      height: "100%",
                      colors: [ "#28756f" ],
                      legend: false,
                      thousands: ".",
                      suffix: " lowongan",
                      library: chart_axis_options,
                      empty: "Belum ada data program studi" %>
      </div>
    </article>
  </section>

  <aside class="mt-6 flex items-center gap-2 border-t border-base-300 px-1 pt-4 text-xs text-base-content/60" aria-label="Catatan statistik">
    <svg class="size-4 shrink-0 text-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path stroke-linecap="round" d="M12 11v5M12 8h.01" />
    </svg>
    <span>Data merupakan arsip dan dapat berbeda dari kondisi terkini.</span>
  </aside>
</div>
