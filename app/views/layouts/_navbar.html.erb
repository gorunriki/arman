<% navigation_items = [
  [ "Dashboard", root_path, controller_name == "dashboard" ],
  [ "Lowongan", vacancies_path, controller_name == "vacancies" ],
  [ "Penyelenggara", organizers_path, controller_name == "organizers" ]
] %>

<header class="sticky top-0 z-50 border-b border-base-300/80 bg-base-100/90 backdrop-blur-md">
  <div class="navbar mx-auto min-h-16 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="navbar-start">
      <details class="dropdown lg:hidden">
        <summary class="btn btn-ghost btn-square" aria-label="Buka menu navigasi">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>

        <ul class="menu dropdown-content z-50 mt-3 w-56 gap-1 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
          <% navigation_items.each do |label, path, active| %>
            <li>
              <%= link_to label, path,
                    class: class_names("font-medium", "menu-active": active),
                    aria: (active ? { current: "page" } : {}) %>
            </li>
          <% end %>
        </ul>
      </details>

      <%= link_to root_path, class: "btn btn-ghost gap-2 px-2 text-lg sm:text-xl", aria: { label: "Arman — halaman utama" } do %>
        <span class="flex size-9 items-center justify-center rounded-xl bg-primary text-primary-content shadow-sm">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V9l8-5 8 5v10M8 19v-6h8v6M2 19h20" />
          </svg>
        </span>
        <span class="font-bold tracking-tight">Arman</span>
      <% end %>
    </div>

    <nav class="navbar-center hidden lg:flex" aria-label="Navigasi utama">
      <ul class="menu menu-horizontal gap-1 px-1">
        <% navigation_items.each do |label, path, active| %>
          <li>
            <%= link_to label, path,
                  class: class_names("font-medium", "menu-active": active),
                  aria: (active ? { current: "page" } : {}) %>
          </li>
        <% end %>
      </ul>
    </nav>

    <div class="navbar-end">
      <%= link_to vacancies_path, class: "btn btn-primary btn-sm hidden sm:inline-flex" do %>
        Jelajahi lowongan
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" />
        </svg>
      <% end %>
    </div>
  </div>
</header>
