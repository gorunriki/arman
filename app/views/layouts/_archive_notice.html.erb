<% if archive_period_notice.present? %>
  <aside class="mx-auto mt-4 flex w-full max-w-7xl items-start gap-3 px-4 sm:px-6 lg:px-8" aria-label="Keterangan kelengkapan arsip">
    <div class="alert alert-warning w-full border-warning/30 bg-warning/10 text-sm shadow-sm">
      <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path stroke-linecap="round" d="M12 8v5M12 16h.01" />
      </svg>
      <div>
        <p class="font-semibold">Arsip periode ini tidak lengkap</p>
        <p class="mt-0.5 leading-5 opacity-80"><%= archive_period_notice %></p>
      </div>
    </div>
  </aside>
<% end %>
